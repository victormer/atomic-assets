{
  "name": "@victormer/atomic-assets",
  "version": "0.1.0",
  "description": "Asset loader with automatic fallbacks for 2D and 3D games. Load images, textures, and audio with graceful degradation.",
  "main": "dist/atomic-assets.js",
  "module": "src/index.js",
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "assets",
    "loader",
    "game",
    "threejs",
    "canvas",
    "fallback",
    "placeholder",
    "texture",
    "audio",
    "atomic-coding"
  ],
  "author": "",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/victormer/atomic-assets.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "rollup": "^4.0.0",
    "@rollup/plugin-terser": "^0.4.0"
  }
}
